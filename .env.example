# DeepCore-N1 environment - copy to .env and fill in what you have.
# Without CRUSOE_API_KEY the evolution loop uses the deterministic fallback patch library.
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.crusoe.ai/v1
CRUSOE_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct
# egl on headless GPU boxes
MUJOCO_GL=
# optional, unused by the evolution loop per Law 6
YOU_KEY=
